---
import mockWorks from './data/works.json';
import siteData from './data/site.json';
import Layout from '../layouts/Layout.astro';
import WorkCard from '../components/WorkCard.astro';
---

<Layout title={siteData.siteTitle}>
	<main>
		<h2 class="section-title">EXHIBITION WORKS</h2>
		<div class="gallery-grid">
			{mockWorks.map((work) => (
				<WorkCard work={work} />
			))}
		</div>
	</main>
</Layout>

<style>
	.section-title {
		text-align: center;
		color: #111;
		font-size: 1.3rem;
		font-weight: 500;
		margin-bottom: 40px;
		letter-spacing: 0.05em;
	}
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
		gap: 48px;
	}
</style>